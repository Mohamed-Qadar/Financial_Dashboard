# Copy to .env for local development:  cp .env.example .env
# Values here are development placeholders only. Never use them in production.

# --- Django ---
DJANGO_ENV=development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-only-insecure-secret-key-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
DJANGO_LOG_LEVEL=INFO
# Optional: "json" (default, structured) or "text" (easier to read locally).
# DJANGO_LOG_FORMAT=text

# --- Authentication (optional in development; see docs/SECURITY.md § 3) ---
# Base URL used in password-reset links (production: https only).
# DJANGO_FRONTEND_BASE_URL=http://localhost:3000
# Development default prints e-mails to the backend log; production needs a real backend.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# CIDR list of proxies whose X-Forwarded-For is trusted. Leave empty in development: the
# Next.js proxy forwards client-supplied headers unchanged. Must be set in production.
# DJANGO_TRUSTED_PROXIES=
# Self-registration of new businesses (POST /api/v1/auth/register/). Default: open in
# development and test, closed in production.
# DJANGO_REGISTRATION_OPEN=true

# --- PostgreSQL ---
POSTGRES_DB=somali_erp
# Owner role: owns the schema, runs migrations (DJANGO_DB_ROLE=owner).
POSTGRES_USER=somali_erp
POSTGRES_PASSWORD=dev-only-password
# Runtime role used by the web process (default DJANGO_DB_ROLE=app): no superuser, no RLS bypass.
POSTGRES_APP_USER=somali_erp_app
POSTGRES_APP_PASSWORD=dev-only-app-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Host ports (change if they clash with something else on your machine) ---
DB_HOST_PORT=5433
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=3000
